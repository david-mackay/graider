NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

DATABASE_URL=postgresql://graider:graider@localhost:5432/graider

# Supabase Storage (required in production so Vercel API + Render worker share uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TEST_UPLOAD_BUCKET=test-uploads

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=gpt-4o-mini

# Reducto — PDF / photo answer-key & question-bank import (Vercel API + Render worker)
REDUCTO_API_KEY=

# Local-only fallback when SUPABASE_* is unset (API + worker must share the same path)
UPLOAD_DIR=./uploads

# Async grade-stack queue (BullMQ + Render Redis)
REDIS_URL=redis://localhost:6379
GRADE_STACK_QUEUE_NAME=grade-stack
GRADE_STACK_QUEUE_PREFIX=graider
GRADE_STACK_WORKER_CONCURRENCY=2
GRADE_STACK_JOB_ATTEMPTS=3
GRADE_STACK_JOB_BACKOFF_MS=5000
GRADE_STACK_JOB_TTL_SECONDS=604800

# RevenueCat (server-side subscriber verification + webhooks)
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
# Public Web Billing API key (rcb_… / test key) for @revenuecat/purchases-js checkout
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=

# Grade-stack worker (Render background service)
WORKER_HEALTH_PORT=10000

# Optional: Expo push when grading jobs finish
EXPO_ACCESS_TOKEN=
